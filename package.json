{
  "name": "gtd-board",
  "version": "0.3.7",
  "description": "GTD-Kanban-Board Plugin fuer Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.2",
    "tslib": "2.6.2",
    "typescript": "^5.4.5"
  }
}
